# Public origin of the deployed site. Used by Vite's index.html env
# replacement (%VITE_SITE_URL%) to build ABSOLUTE Open Graph URLs —
# og:image and og:url must be absolute or no crawler (WhatsApp, X,
# LinkedIn, Slack) can resolve them. Change this to the real domain at
# deploy time, or override it locally with .env.local.
VITE_SITE_URL=https://devclub-premium.pages.dev
